  "name": "maximedrn",
  "packageManager": "bun@1.3.14",
  "patchedDependencies": {
    "satori@0.28.2": "patches/satori@0.28.2.patch"
  },
  "private": true,
  "scripts": {
    "cspell": "cspell lint --config cspell.yaml --no-progress --dot",
    "generate": "bun scripts/generate.ts",
    "lint:check": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "lefthook install",
    "preview": "next dev --turbopack",
    "preview:build": "next build --turbopack",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "verify": "bun run lint:check && bun run cspell && bun run typecheck && bun run test && bun run generate"
  },
  "type": "module"
}
